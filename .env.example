# Port HTTP interne
PORT=3000
# Dossier où est stockée la base SQLite (five.db)
DATA_DIR=./data
# Fuseau horaire du serveur (l'app utilise aussi le réglage "timezone", Europe/Paris par défaut)
TZ=Europe/Paris
# URL publique, utilisée pour les liens dans les emails
APP_URL=https://five.vaultnode.fr
# Contact obligatoire pour le Web Push (une adresse mail à toi)
VAPID_SUBJECT=mailto:toi@example.com
# Code d'invitation initial (utilisé seulement tant qu'aucun compte n'existe ; modifiable ensuite dans l'app)
INVITE_CODE=change-moi
# Mettre 0 si l'app n'est PAS derrière un reverse proxy
TRUST_PROXY=1

# Clés Web Push : générées et stockées automatiquement dans la base si absentes.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# Rappels par email (facultatif)
# SMTP_HOST=ssl0.ovh.net
# SMTP_PORT=465
# SMTP_USER=five@ton-domaine.fr
# SMTP_PASS=
# SMTP_FROM=five@ton-domaine.fr
